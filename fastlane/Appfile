for_platform :ios do
  app_identifier(ENV.fetch('IOS_APP_IDENTIFIER', 'org.parres.whitenoise'))
  team_id(ENV.fetch('APPLE_TEAM_ID', 'QL6TB358UB'))

  apple_id(ENV['APPLE_ID']) if ENV['APPLE_ID']
end

for_platform :android do
  package_name(ENV.fetch('ANDROID_PACKAGE_NAME', 'org.parres.whitenoise'))

  json_key_file(ENV['GOOGLE_PLAY_JSON_KEY_FILE']) if ENV['GOOGLE_PLAY_JSON_KEY_FILE']
end
